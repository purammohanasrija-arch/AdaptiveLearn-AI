# =============================================================================
# AdaptiveLearn AI – Production & Development Environment Configuration
# =============================================================================

# Server & Host Configuration
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Connection (SQLite local file by default; or PostgreSQL / MySQL)
DATABASE_URL=sqlite:///adaptive_learn.db

# Cryptographic JWT Secret Key (Use at least 32 characters for HS256)
JWT_SECRET_KEY=adaptive-learn-ai-secret-key-production-grade-2026-super-secure
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta / Facebook Login Credentials
# Obtain from: https://developers.facebook.com/apps
# Valid OAuth Redirect URI: http://localhost:5000/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Transactional SMTP Email Provider (SendGrid, Mailgun, Amazon SES, or Custom SMTP)
# When left empty, the built-in email service logs all verification links & OTPs to local console & OUTBOX
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@adaptlearn.ai

# Optional AI Engine Key (Gemini API for live LLM inference)
GEMINI_API_KEY=
