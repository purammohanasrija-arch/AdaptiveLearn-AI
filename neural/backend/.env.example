# AdaptiveLearn AI - Backend Production Environment Variables
# Application
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Security & JWT Tokens
JWT_SECRET_KEY=adaptive_learn_production_secret_key_change_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth 2.0 Providers (Optional - Demo fallback active if omitted)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email SMTP Delivery (Optional - In-memory / console log fallback active if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@adaptivelearn.ai
